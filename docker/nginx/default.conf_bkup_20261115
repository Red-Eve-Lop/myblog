server {
    listen 80;
    server_name localhost;

    root /var/www/public;
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
    fastcgi_pass php:9000;
    include fastcgi.conf;
    }

    location ~ /\.ht {
        deny all;
    }
}   
